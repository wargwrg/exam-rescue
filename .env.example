# Copy this file to ".env.local" for local testing, or add these in Vercel → Settings → Environment Variables.
# Leave them empty and the app runs in DEMO MODE (data saved in the browser, unlock without paying).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lemon Squeezy → Products → your product → Share → checkout link
VITE_CHECKOUT_URL=
VITE_PRICE_LABEL=€14.99

# Server-only (payment webhook). Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
